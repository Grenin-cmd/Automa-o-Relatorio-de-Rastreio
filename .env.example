# Copie este arquivo para ".env" e preencha os valores.

# Chave usada para assinar a sessão (cookie). Se vazia, uma chave é gerada e
# salva no arquivo .secret_key ao lado do programa.
FLASK_SECRET_KEY=

# Primeiro administrador: só é criado quando o banco não tem nenhum usuário.
# Sem ADMIN_INICIAL_SENHA, uma senha aleatória é gerada, exibida no console e
# salva em senha_inicial_admin.txt. A troca é obrigatória no primeiro login.
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_SENHA=

# Endereço do servidor. 127.0.0.1 = só esta máquina.
# Use 0.0.0.0 para liberar o acesso a outros computadores da rede.
HOST=127.0.0.1
PORT=

# Token exigido pelas rotas /api/* (header "Authorization: Bearer <token>"
# ou "X-API-Key: <token>"). Sem token, as APIs exigem usuário logado.
API_TOKEN=

# Pasta onde ficam o banco (poi_store.db) e a chave secreta.
# Padrão: a mesma pasta do programa.
RASTREIO_DATA_DIR=

# IA (opcionais)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=15000
